<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>点群、ジェスチャー、AR、近くの端末へのライブ映像の実験でカメラを使います。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>拍手や笑い声を端末内で分類するためにマイクを使います。</string>
    <key>NSMotionUsageDescription</key>
    <string>iPhoneの傾きでビー玉を転がすために使います。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>宝探しで近くのiPhoneを見つけ、測距に必要な情報を交換します。</string>
    <key>NSNearbyInteractionUsageDescription</key>
    <string>宝探しで相手のiPhoneまでの距離と方向を測ります。</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_ailab-find._tcp</string>
        <string>_ailab-find._udp</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
    <key>WiFiAwareServices</key>
    <dict>
        <key>_ailab-video._tcp</key>
        <dict>
            <key>Publishable</key><dict/>
            <key>Subscribable</key><dict/>
        </dict>
    </dict>
</dict>
</plist>
